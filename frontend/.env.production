# Teezer web - production build config (committed).
#
# PUBLIC values only: every NEXT_PUBLIC_ variable is inlined into the browser
# bundle. Never put a secret here. Site/client keys are set on the VPS in
# .env.production.local (git-ignored), which overrides this file at build time.

NEXT_PUBLIC_API_URL=https://api.teezer.live/api/v1
NEXT_PUBLIC_APP_URL=https://teezer.live
NEXT_PUBLIC_FRONTEND_URL=https://teezer.live
NEXT_PUBLIC_WEB_URL=https://teezer.live
NEXT_PUBLIC_APP_NAME=Teezer

# Centrifugo realtime WebSocket (authorised by server-minted tokens).
NEXT_PUBLIC_CENTRIFUGO_URL=wss://realtime.teezer.live/connection/websocket

# Public media/CDN base.
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.teezer.live

# Sign in with Apple (web) return URL - must match the Services ID config.
NEXT_PUBLIC_APPLE_REDIRECT_URI=https://teezer.live/login

# Public site/client keys - set on VPS in .env.production.local
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# set on VPS in .env.production.local
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# set on VPS in .env.production.local
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# set on VPS in .env.production.local
NEXT_PUBLIC_APPLE_SERVICES_ID=
# set on VPS in .env.production.local
NEXT_PUBLIC_GIPHY_API_KEY=
