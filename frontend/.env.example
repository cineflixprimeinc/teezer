# ──────────────────────────────────────────────────────────────────────────
# Teezer web - frontend environment template.
#
# IMPORTANT: every variable here is prefixed NEXT_PUBLIC_, which means Next.js
# inlines it into the browser bundle and ANYONE can read it. NEVER put a real
# secret (Stripe/PayPal secret key, DB URL, API secret, app key) in this file.
# Secrets live only in the server's .env. The keys below are public client/site
# keys, which are designed to be exposed.
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────────────

# ── Public config (URLs / flags - not secrets) ──
NEXT_PUBLIC_API_URL=https://api.teezer.live/api/v1
NEXT_PUBLIC_APP_URL=https://teezer.live
NEXT_PUBLIC_APP_NAME=Teezer
NEXT_PUBLIC_API_WITH_CREDENTIALS=false

# Real-time endpoints (public URLs)
NEXT_PUBLIC_CHAT_SERVER_URL=
NEXT_PUBLIC_SOCKET_URL=
# Centrifugo WebSocket endpoint. Public URL, not a secret - the connection is
# authorised by a short-lived token minted server-side, never by this value.
NEXT_PUBLIC_CENTRIFUGO_URL=wss://realtime.teezer.live/connection/websocket

# Public CDN base for media (Cloudflare R2 public domain)
NEXT_PUBLIC_R2_PUBLIC_URL=https://cdn.teezer.live

# ── Public keys (CLIENT/SITE keys only - NOT secret keys) ──
# Cloudflare Turnstile SITE key (the SECRET key stays on the server only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# PayPal CLIENT ID only (the secret stays on the server)
# https://developer.paypal.com → My Apps & Credentials → Client ID
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Giphy client key - rate-limited public key. Restrict it to your domain in
# the Giphy dashboard. https://developers.giphy.com/
NEXT_PUBLIC_GIPHY_API_KEY=

# Google Identity Services - the OAuth "Web application" client ID from
# Google Cloud Console (public by design, not a secret). The backend must
# also have this same ID added to its allow-list - Admin -> Settings ->
# Social Login -> Google -> Client ID(s) (server/app/Services/SocialLoginConfig.php).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Sign in with Apple (web). This is the SERVICES ID from the Apple Developer
# portal - NOT the app's bundle id. Both must be listed in
# Admin > Social Login > Apple > Bundle ID(s), since Apple stamps the Services
# ID as the token audience for web sign-ins.
NEXT_PUBLIC_APPLE_SERVICES_ID=
# Must match a Return URL registered on that Services ID exactly. Defaults to
# https://teezer.live/login when unset.
NEXT_PUBLIC_APPLE_REDIRECT_URI=

# ─────────────────────────────────────────────────────────────────────────────
# INTERNAL_API_URL - the API address used by SERVER-SIDE rendering only.
#
# Not the same as NEXT_PUBLIC_API_URL. That one is the browser's address for
# the API; requesting it from the server the API runs on returns 403 in
# production, because Cloudflare blocks requests that originate from the origin
# itself. Server-rendered metadata (src/lib/site-settings.ts) therefore has to
# go direct.
#
# Leave unset in local development, where the two are the same thing.
# INTERNAL_API_URL=http://127.0.0.1:8091/api/v1
