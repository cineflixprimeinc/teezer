# ──────────────────────────────────────────────────────────────────────────
# Teezer admin - frontend environment template.
# Every NEXT_PUBLIC_ variable is inlined into the browser bundle and is public.
# NEVER put a real secret here - secrets live only in the server's .env.
# Copy this file to .env.local and fill in the values.
# ──────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=https://api.teezer.live/api/v1
NEXT_PUBLIC_ADMIN_URL=https://backend.teezer.live
NEXT_PUBLIC_FRONTEND_URL=https://teezer.live
NEXT_PUBLIC_APP_URL=https://teezer.live
# Public site origin used when building gift/coin links.
NEXT_PUBLIC_WEB_URL=https://teezer.live

# Cloudflare Turnstile SITE key (same as the public site; SECRET stays on the server)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
