# ──────────────────────────────────────────────────────────────────────────
# Teezer mobile - Expo environment template.
#
# IMPORTANT: every variable here is prefixed EXPO_PUBLIC_, which means Expo
# inlines it into the JS bundle that ships inside the .ipa/.apk. Anyone can
# extract it from an installed app. NEVER put a real secret (API secret,
# service key, DB URL, signing key, OAuth client SECRET) in this file.
# Server-side secrets live only in server/.env.
#
# Copy this file to .env and fill in the values. .env is gitignored (root
# .gitignore) - only this .example file is ever committed.
# ──────────────────────────────────────────────────────────────────────────

# ── Build target: development | staging | production ──
# Selects the URL block in app.config.ts. Not read at runtime.
APP_ENV=development

# ── Public config (URLs - not secrets) ──
# Override for local API work; on a real device use your machine's LAN IP,
# e.g. http://192.168.1.20:8000/api/v1. Ignored when APP_ENV=production.
EXPO_PUBLIC_API_BASE_URL=https://api.teezer.live/api/v1
EXPO_PUBLIC_CHAT_SERVER_URL=https://api.teezer.live

# ── OAuth CLIENT IDs (public identifiers - NOT client secrets) ──
# Google client IDs are public by design; the client SECRET is server-side only
# and must never appear here. https://console.cloud.google.com/apis/credentials
# WEB_CLIENT_ID is used on BOTH platforms (it's what the ID token's audience
# must match server-side - see server/app/Services/SocialLoginConfig.php);
# IOS_CLIENT_ID/IOS_URL_SCHEME are only needed to sign in from an iOS build.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Google's own "reversed client ID" for the iOS OAuth client, shown right on
# that client's page in Google Cloud Console - NOT the client ID itself.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# ── Third-party GIF provider key (client key - account-scoped) ──
# This ships in the bundle and is extractable, so it is not a secret. It is
# still billed/rate-limited against our account, so keep it out of git and
# restrict it in the Klipy dashboard where possible.
# Klipy powers the comment GIF picker. The key is a URL PATH segment.
# Leave blank and the picker returns an empty list - it fails closed.
#
# Note: the web app uses Giphy (NEXT_PUBLIC_GIPHY_API_KEY in frontend/.env.example);
# mobile does not - it is Klipy-only, so there is no Giphy key here.
EXPO_PUBLIC_KLIPY_KEY=
