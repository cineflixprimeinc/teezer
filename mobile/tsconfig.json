{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // TypeScript 6 (SDK 57 bump) deprecates baseUrl - not removing it, since
    // this project's whole @/* path-alias convention depends on it; this is
    // exactly the silencing option TS itself suggests for the transition.
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
