APP_NAME=Teezer
APP_ENV=production
# Generate with: php artisan key:generate  (produces a 32-byte base64 key)
APP_KEY=
# Comma-separated OLD APP_KEYs, kept only so already-encrypted columns stay
# readable after rotating APP_KEY. Rotating APP_KEY without listing the previous
# key here makes every encrypted column permanently undecryptable.
# APP_PREVIOUS_KEYS=
# Defaults to OFF. With APP_DEBUG=true Laravel returns a full stack trace -
# file paths, SQL, and the values bound into it - to whoever made the request.
# A copied .env must never start life in that state; turn it on deliberately
# for local debugging, never on a deployed box.
APP_DEBUG=false
APP_URL=https://api.teezer.live

# Password hashing - bcrypt work factor (project minimum 12). Use argon2id via
# HASH_DRIVER=argon2id if preferred.
HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production runs PostgreSQL - see the DB_PGSQL_* block below. DB_HOST/PORT/
# DATABASE/USERNAME/PASSWORD here are only read by the mysql connection.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teezer
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
CACHE_STORE=redis
# local dev: public | production: b2
FILESYSTEM_DISK=b2
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_EXPIRE_ON_CLOSE=false
SESSION_DOMAIN=.teezer.live
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ─────────────────────────────────────────────────────────────────────────────
# Frontend & CORS
# CORS_ORIGIN: comma-separated list of allowed frontend origins.
# Local dev: localhost:3000 (web) + localhost:3001 (admin)
# Production: https://teezer.live,https://www.teezer.live,https://backend.teezer.live
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://teezer.live
ADMIN_FRONTEND_URL=https://backend.teezer.live
CORS_ORIGIN=https://teezer.live,https://www.teezer.live,https://backend.teezer.live
CORS_SUPPORTS_CREDENTIALS=false

# Sanctum - domains allowed to make stateful requests
# Local: localhost,127.0.0.1
# Production: teezer.live,www.teezer.live,backend.teezer.live,api.teezer.live
SANCTUM_STATEFUL_DOMAINS=teezer.live,www.teezer.live,backend.teezer.live,api.teezer.live
SANCTUM_EXPIRATION=43200

# ─────────────────────────────────────────────────────────────────────────────
# Admin panel two-factor authentication
# ─────────────────────────────────────────────────────────────────────────────
# ADMIN_2FA_ENFORCED decides whether an admin who already has 2FA on their
# account must clear a challenge before the admin panel will answer. It is the
# gate that actually controls admin access.
#
# Shipped as false so a demo account can walk through the admin UI without a
# TOTP device. SET THIS TO true BEFORE THE PANEL IS IN FRONT OF REAL DATA - it
# controls bans, payouts, coin balances and user data, so with the gate off one
# leaked admin password is total control. Nothing was deleted to turn it off;
# flipping it back needs no code change and no rebuild.
ADMIN_2FA_ENFORCED=true

# ADMIN_2FA_REQUIRED is the separate, stricter switch: it forces every admin to
# ENROL in 2FA before any admin endpoint works. Has no effect while
# ADMIN_2FA_ENFORCED=false.
ADMIN_2FA_REQUIRED=false

# Neither flag affects a normal user's own 2FA. Enrolling, confirming,
# disabling, recovery codes and the settings UI on web and mobile all keep
# working regardless.

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@teezer.live"
MAIL_FROM_NAME="${APP_NAME}"

# Admin seeder credentials (used only during initial db:seed)
# IMPORTANT: Change ADMIN_PASSWORD immediately after first deploy + seed
ADMIN_NAME="Teezer Admin"
ADMIN_EMAIL=teezerlive94@gmail.com
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_SEEDING

# ─────────────────────────────────────────────────────────────────────────────
# Backblaze B2 - Object Storage for all uploaded media
# Set FILESYSTEM_DISK=b2 in production to activate.
# Never commit real values. Never expose these to the mobile app or browser -
# the client only ever sees a presigned URL minted by the API.
#
# The bucket is PRIVATE. Nothing is readable straight from B2; every read goes
# through MEDIA_URL, where the Cloudflare Worker checks the signed-URL token
# and then fetches from B2 with its own credentials.
#
# B2_REGION must match the region inside B2_ENDPOINT. If they disagree, every
# request fails SigV4 with an error that names neither of them.
# ─────────────────────────────────────────────────────────────────────────────
# NOT the master application key - Backblaze rejects the master key on the S3
# API entirely ("Malformed Access Key Id"). Create a normal application key.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=CHANGE_ME_TEEZER_MEDIA_BUCKET
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005

# Public CDN hostname that fronts the bucket. Every stored URL is built from
# this, never from B2_ENDPOINT.
# CDN hostname only - no /file/<bucket> suffix. Production should run through
# the nginx signed-media origin in deploy/nginx/reelsoo-media.conf, so the app
# must not add B2's /file/<bucket> prefix to client-facing URLs.
MEDIA_URL=https://cdn.teezer.live
B2_SERVE_DIRECT=false

# Shared HMAC secret with the media Worker (openssl rand -hex 32). Must be
# byte-identical to the Worker's SIGNING_SECRET or every video 403s.
MEDIA_SIGNING_SECRET=

# Set false when the public bucket is served straight through the CDN with no
# edge worker validating tokens. Leave true while a signing worker exists.
MEDIA_SIGNED_URLS=true


# Maximum video upload size in megabytes. Enforced by both the presigned-URL
# endpoint and the legacy multipart endpoint.
MAX_VIDEO_UPLOAD_SIZE_MB=500

# ─────────────────────────────────────────────────────────────────────────────
# StreamHub / LiveKit - self-hosted real-time media (Spaces, and later live
# video / calls / PK battles). Replaces the Cloudflare Realtime SFU integration
# below (which stays configured as a rollback path - do not remove it).
#
# LIVEKIT_HOST is the internal (never public) LiveKit server address, e.g.
# http://127.0.0.1:7880 if StreamHub and livekit-server share a box, or the
# private IP if livekit-server runs on a separate node.
# LIVEKIT_API_KEY/SECRET sign Twirp room-service calls + participant JWTs -
# server-only, never sent to a client. Generate a key/secret pair with the
# livekit-server CLI (`livekit-server generate-keys`) and put the SAME pair
# in livekit-server's own config (deploy/livekit/). LiveKit signs its own
# webhooks with this SAME pair too - there is no separate webhook secret.
#
# Recording destination is independently configurable - defaults to the
# existing B2 bucket under a separate prefix, but can point anywhere
# S3-compatible without touching StreamHub's code. The access key/secret used
# to upload there are read from that disk's OWN config block above (e.g.
# B2_APPLICATION_KEY_ID/B2_APPLICATION_KEY) - not duplicated here.
# ─────────────────────────────────────────────────────────────────────────────
LIVEKIT_HOST=https://livekit.teezer.live
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_RECORDING_DISK=b2
LIVEKIT_RECORDING_BUCKET=
LIVEKIT_RECORDING_PREFIX=recordings/spaces

# Cloudflare Realtime (serverless SFU) - the Spaces media provider being
# replaced by StreamHub/LiveKit above. Left configured intentionally: the
# fastest rollback path is reverting the controller wiring, not a re-deploy.
CF_REALTIME_APP_ID=
CF_REALTIME_API_TOKEN=
CF_REALTIME_BASE_URL=https://rtc.live.cloudflare.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# Content moderation
#
# The pre-publish CONTENT_CHECK_* scan was removed - uploads no longer block on
# an NSFW verdict, and the /upload/content-check endpoint is gone. The NSFWJS
# microservice it called is therefore unused and can be stopped.
#
# MODERATION_ENABLED still controls background post-publish NudeNet scanning,
# which is a separate pipeline (ScanVideoJob/ScanImageJob on the moderation
# queue) and is unaffected.
# ─────────────────────────────────────────────────────────────────────────────
MODERATION_ENABLED=true
NUDENET_PYTHON=python3
NUDENET_SCANNER_SCRIPT=/var/www/teezer/server/scripts/nudenet_scan.py
NUDENET_TIMEOUT=300
NUDENET_BLOCK_THRESHOLD=0.72
NUDENET_MAX_FRAMES=45

# scanner/ FastAPI microservice (ModerationService::callScanner()). Must match
# SCANNER_API_KEY in scanner/.env on the box the scanner runs on, or every
# scan call is sent with no key and the scanner's own auth check has nothing
# to compare against.
SCANNER_URL=http://127.0.0.1:7891
SCANNER_API_KEY=
SCANNER_TIMEOUT=300

# ─────────────────────────────────────────────────────────────────────────────
# PayPal - Coin purchase payments
# Get credentials at https://developer.paypal.com → My Apps & Credentials.
# Set PAYPAL_MODE=live in production.
# ─────────────────────────────────────────────────────────────────────────────
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Redis - Phase 6+ (cache, queue, sessions)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Firebase Push Notifications - Phase 5+
# FIREBASE_CREDENTIALS=/var/www/teezer/server/storage/app/firebase-credentials.json
# FIREBASE_PROJECT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Meilisearch - self-hosted full-text search
# Install: curl -L https://install.meilisearch.com | sh
# Run:     ./meilisearch --master-key="YOUR_MASTER_KEY" --env production
# Never expose MEILISEARCH_KEY to the frontend - Laravel proxies all queries.
# ─────────────────────────────────────────────────────────────────────────────
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# ═════════════════════════════════════════════════════════════════════════════
# The blocks below are referenced by server/config/*.php but were previously
# undocumented in this file - which is how a deploy comes up missing keys with
# no error, just silently wrong behaviour. Secrets are left BLANK; non-secrets
# show the code's own default. Nothing here is a real credential.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL - the production database
# ⚠️ config/database.php's pgsql block reads DB_PGSQL_*, NOT the DB_* keys near
# the top of this file. DB_HOST/DB_PORT are never read for pgsql. Set
# DB_CONNECTION=pgsql *and* fill these in, or the app quietly keeps using mysql.
# ─────────────────────────────────────────────────────────────────────────────
DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5432
DB_PGSQL_DATABASE=teezer
DB_PGSQL_USERNAME=teezer
DB_PGSQL_PASSWORD=
DB_PGSQL_CHARSET=utf8
DB_PGSQL_SEARCH_PATH=public
DB_PGSQL_SSLMODE=prefer
# Optional split read/write endpoints - default to DB_PGSQL_HOST/PORT.
# DB_PGSQL_READ_HOST=
# DB_PGSQL_WRITE_HOST=
# Full DSN alternative; overrides the discrete keys above when set.
# DB_PGSQL_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Redis - cache, queue and session backend
# ─────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_URL=
# REDIS_PREFIX=

# ─────────────────────────────────────────────────────────────────────────────
# Centrifugo - realtime WebSocket engine
# Both keys are SECRETS and must match Centrifugo's own config byte-for-byte.
# CENTRIFUGO_API_URL is the internal address - never the public wss:// URL.
# ─────────────────────────────────────────────────────────────────────────────
# Public client endpoint (set on the web/mobile side, not read by Laravel):
#   wss://realtime.teezer.live/connection/websocket
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_TOKEN_TTL=3600

# ─────────────────────────────────────────────────────────────────────────────
# ClickHouse - analytics store
# ─────────────────────────────────────────────────────────────────────────────
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=reelsoo
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=reelsoo
CLICKHOUSE_TIMEOUT=15

# ─────────────────────────────────────────────────────────────────────────────
# api.video - external transcoding provider. APIVIDEO_ENABLED is the kill
# switch: false (default) leaves every video on the local-ffmpeg
# TranscodeVideoToHls pipeline, completely unaffected. APIVIDEO_API_KEY and
# APIVIDEO_WEBHOOK_SECRET are SECRETS: never commit real values, never expose
# to mobile/web. The webhook secret comes back from api.video when you create
# the webhook (POST /webhooks against https://ws.api.video) - it is not the
# API key itself.
# ─────────────────────────────────────────────────────────────────────────────
APIVIDEO_ENABLED=false
APIVIDEO_API_KEY=
APIVIDEO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# countries.dev - optional country-data/geolocation provider (free, keyless,
# no documented rate limit). COUNTRIES_DEV_ENABLED is the kill switch: false
# (default) leaves country detection on IpCountryService's existing CF-header
# -> MMDB -> hardcoded-default cascade, and country metadata reads only the
# local country_metadata table - both fully unaffected. No secret to set;
# countries.dev needs no API key.
# ─────────────────────────────────────────────────────────────────────────────
COUNTRIES_DEV_ENABLED=false
COUNTRIES_DEV_BASE_URL=https://countries.dev
COUNTRIES_DEV_TIMEOUT=5
COUNTRIES_DEV_MAX_CONCURRENT_REQUESTS=5
COUNTRIES_DEV_RETRY_LIMIT=2
COUNTRIES_DEV_CACHE_TTL=604800
COUNTRIES_DEV_GEO_CACHE_TTL=3600
COUNTRIES_DEV_CIRCUIT_BREAKER_THRESHOLD=5
COUNTRIES_DEV_CIRCUIT_BREAKER_COOLDOWN=60

# ─────────────────────────────────────────────────────────────────────────────
# Typesense - search backend (alongside the Meilisearch block above).
# TYPESENSE_API_KEY is a SECRET: never expose it to the frontend, Laravel
# proxies every query.
# ─────────────────────────────────────────────────────────────────────────────
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Sightengine - hosted moderation API. The API secret is a SECRET.
# ─────────────────────────────────────────────────────────────────────────────
SIGHTENGINE_ENABLED=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_MODELS=nudity-2.1
SIGHTENGINE_BLOCK_THRESHOLD=0.80
SIGHTENGINE_REVIEW_THRESHOLD=0.50

# Text moderation + moderation presigned-URL lifetime (minutes)
TEXT_MODERATION_ENABLED=true
TEXT_MODERATION_REVIEW_THRESHOLD=2
MODERATION_PRESIGN_TTL=60

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile - bot check on the web auth forms.
# SECRET key only. The SITE key is public and belongs in frontend/.env.local as
# NEXT_PUBLIC_TURNSTILE_SITE_KEY - never put this secret behind a public prefix.
# ─────────────────────────────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# AWS / S3 - read by config/queue.php (SQS) and the s3 filesystem disk. Unused
# while QUEUE_CONNECTION=database and FILESYSTEM_DISK=b2, but referenced by
# config, so documented here. Both are SECRETS whenever they are set.
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─────────────────────────────────────────────────────────────────────────────
# Signing / internal secrets - generate each with: openssl rand -hex 32
# ADS_SIGNING_SECRET signs ad click/impression callbacks.
# INTERNAL_API_SECRET authenticates service-to-service calls.
# ─────────────────────────────────────────────────────────────────────────────
ADS_SIGNING_SECRET=
INTERNAL_API_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Push notifications
# FCM_CREDENTIALS and APNS_KEY_PATH are paths to key files on disk. Keep those
# files outside the repo (e.g. storage/app/) - they are credentials themselves
# and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────
PUSH_ENABLED=true
FCM_PROJECT_ID=
FCM_CREDENTIALS=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.teezer.app
APNS_PRODUCTION=true

# ─────────────────────────────────────────────────────────────────────────────
# Social sign-in - public CLIENT IDs, not secrets. Comma-separated; every
# audience the API should accept must be listed.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_IDS=com.teezer.app

# ─────────────────────────────────────────────────────────────────────────────
# Cross-subdomain SSO cookie
# ─────────────────────────────────────────────────────────────────────────────
SSO_COOKIE_DOMAIN=.teezer.live
# Defaults to the inverse of APP_DEBUG; set explicitly in production.
# SSO_COOKIE_SECURE=true
SSO_LIFETIME_MINUTES=43200

# ─────────────────────────────────────────────────────────────────────────────
# Misc
# ⚠️ B2_VISIBILITY must match the bucket's ACTUAL visibility. It is derived from
# B2_SERVE_DIRECT (false => private) unless set. A mismatch makes B2 reject
# every WRITE with "Unsupported value for canned acl" while reads keep working -
# so the site looks healthy while uploads/transcodes silently fail.
# ─────────────────────────────────────────────────────────────────────────────
APP_FRONTEND_URL=https://teezer.live
MAX_IMAGE_UPLOAD_SIZE_MB=20
B2_USE_PATH_STYLE=true
# B2_VISIBILITY=private
GEOIP_MMDB_PATH=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# ─────────────────────────────────────────────────────────────────────────────
# Ads - non-secret tuning knobs, all with working defaults in config/ads.php.
# Note ADS_ENABLED defaults to FALSE, so ads stay off until set explicitly.
# The ADS_FX_* currency table (30+ keys) and the ADS_FRAUD_*/ADS_FREQCAP_*
# thresholds are omitted here: they are tuning data, not deployment config.
# ─────────────────────────────────────────────────────────────────────────────
ADS_ENABLED=false
ADS_CURRENCY=USD
ADS_REVIEW_MODE=manual

# Production overrides (uncomment and set when deploying to VPS)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.teezer.live
# SESSION_DOMAIN=.teezer.live
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# CORS_SUPPORTS_CREDENTIALS=true
# SANCTUM_STATEFUL_DOMAINS=teezer.live,www.teezer.live,backend.teezer.live,api.teezer.live
# SANCTUM_EXPIRATION=43200
# LOG_CHANNEL=daily
# LOG_LEVEL=error
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

# ─────────────────────────────────────────────────────────────────────────────
# Marketplace licensing
#
# Two INDEPENDENT halves - see config/licensing.php for the full explanation.
# Both default to OFF, which is what Teezer runs.
#
#   LICENSE_SERVER_ENABLED    - turns THIS install into the licence server.
#                               Only ever true on a licensor. The /license/*
#                               endpoints do not exist at all while it is false.
#   LICENSING_CLIENT_ENABLED  - turns on licence ENFORCEMENT for this install.
#                               Only ever true in a customer package. Setting it
#                               true on this install would block production on a
#                               licence it does not have.
# ─────────────────────────────────────────────────────────────────────────────
LICENSE_SERVER_ENABLED=false
LICENSING_CLIENT_ENABLED=false
# Empty on purpose: this install never contacts a licence server.
LICENSE_SERVER_URL=

# ── Licence server (licensor only) ───────────────────────────────────────────
# The private signing key MUST live outside the repository and MUST NEVER be
# committed, packaged, copied to a customer VPS, or backed up anywhere readable.
# Generate it once with: php artisan license:keygen
# LICENSE_SIGNING_PRIVATE_KEY_PATH=/etc/teezer/license-signing-key.pem
# LICENSE_SIGNING_PRIVATE_KEY_PASSPHRASE=
# LICENSE_TOKEN_TTL_DAYS=90
# LICENSE_RELEASE_DISK=b2
# LICENSE_RELEASE_PREFIX=releases
# LICENSE_RELEASE_URL_TTL_MINUTES=15

# ── Customer installation (set by the installer, not by us) ──────────────────
# LICENSE_KEY is the credential the scheduled heartbeat and `reelsoo update`
# use. It is deliberately NOT stored in the licence file, so a leaked licence
# file cannot renew or download anything on its own.
# LICENSE_KEY=
# LICENSE_DOMAIN=
# LICENSE_GRACE_DAYS=30
# LICENSE_STALE_POLICY=warn

# ── Marketplace release storage (licence server only) ────────────────────────
# A SEPARATE, PRIVATE B2 bucket from the media bucket. Releases must never live
# in the media bucket: cdn.teezer.live proxies that one straight through to B2
# (deploy/nginx/reelsoo-media.conf), so anything in it is reachable at a
# guessable URL and the whole product source would be downloadable with the
# licence check bypassed.
#
# Scope this application key to the releases bucket ALONE, so a leak of it
# cannot also reach customer media.
# B2_RELEASES_BUCKET=CHANGE_ME_RELEASES_BUCKET
# B2_RELEASES_APPLICATION_KEY_ID=
# B2_RELEASES_APPLICATION_KEY=
# B2_RELEASES_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_RELEASES_REGION=us-east-005

# ─────────────────────────────────────────────────────────────────────────────
# Third-party integrations
#
# Every key below is ALSO settable from Admin > Settings > Third-Party
# Integrations, and the panel wins: IntegrationRegistry resolves
# database -> env -> config default, so a key rotated in the UI takes effect on
# the next request with no deploy. These entries exist so a fresh install can
# be configured before anyone opens the panel.
#
# Never read these with env() at a call site - go through IntegrationRegistry,
# or rotating the key in the panel silently does nothing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Bunny.net (CDN + Stream) ──
# BUNNYCDN_API_KEY=
# BUNNYCDN_STORAGE_ZONE=
# BUNNYCDN_STORAGE_PASSWORD=
# BUNNYCDN_STORAGE_REGION=
# BUNNYCDN_PULL_ZONE_URL=
# BUNNYCDN_STREAM_LIBRARY_ID=
# BUNNYCDN_STREAM_API_KEY=

# ── Cloudflare Stream (separate token from the DNS/cache one) ──
# Token needs Stream:Edit on the ACCOUNT, not zone permissions.
# CLOUDFLARE_STREAM_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=
# CLOUDFLARE_STREAM_SUBDOMAIN=
# CLOUDFLARE_STREAM_SIGNING_KEY_ID=
# CLOUDFLARE_STREAM_SIGNING_KEY=

# ── NSFW classifiers ──
# Rekognition needs rekognition:DetectModerationLabels.
# AWS_REKOGNITION_KEY_ID=
# AWS_REKOGNITION_SECRET=
# AWS_REKOGNITION_REGION=us-east-1
# AWS_REKOGNITION_MIN_CONFIDENCE=60
# GOOGLE_VISION_API_KEY=
# GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1

# ── Agora (RTC) ──
# App ID/Certificate mint client tokens locally; Customer ID/Secret are the
# REST credentials and are what the panel's connection test uses.
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=

# ── Camera / AR effects ──
# CLIENT-side SDKs: these licences are validated in the browser or on the
# device by the vendor, never by us, so the panel offers no connection test for
# them. Stored here so web and mobile read them from the same place.
# DEEPAR_LICENSE_KEY_WEB=
# DEEPAR_LICENSE_KEY_ANDROID=
# DEEPAR_LICENSE_KEY_IOS=
# BANUBA_CLIENT_TOKEN=
# SNAP_CAMERA_KIT_API_TOKEN=
# SNAP_CAMERA_KIT_LENS_GROUP=
# SNAP_CAMERA_KIT_STAGING_TOKEN=
