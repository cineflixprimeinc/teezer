# Copy to deploy/clickhouse/.env and fill in. NEVER commit the real .env.
#
#   cd deploy/clickhouse && cp .env.clickhouse.example .env && docker compose --env-file .env up -d

# Database name stays `reelsoo`: backend-go hardcodes `INSERT INTO reelsoo.events`
# / `reelsoo.video_processing_events` (internal identifier, not branding).
CLICKHOUSE_DB=reelsoo
CLICKHOUSE_USER=teezer
# Generate: openssl rand -base64 32
CLICKHOUSE_PASSWORD=

# ── What the Go backend needs (goes in the backend-go env, not here) ─────────
# Native protocol, port 9000. Empty => ClickHouse ingestion is DISABLED and the
# backend runs exactly as it does today (Postgres only). That is the kill
# switch: unset this and redeploy to back the whole feature out.
#
#   CLICKHOUSE_DSN=clickhouse://teezer:<password>@127.0.0.1:9000/reelsoo
#
# Cross-VPS (API on VPS-1, ClickHouse on VPS-2) - go over the private network or
# a WireGuard tunnel and turn on TLS. Never point this at a public IP in the clear:
#
#   CLICKHOUSE_DSN=clickhouse://teezer:<password>@10.0.0.2:9000/reelsoo?secure=true
