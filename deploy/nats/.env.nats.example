# Env additions for teezer-go.service to use the NATS event bus - see README.md §2.
# NATS itself needs no secrets: it's bound to 127.0.0.1 only (never externally
# reachable, same posture as teezer-go.service's own :8090), so there is no
# .env for the nats-server process itself.

NATS_URL=nats://127.0.0.1:4222

# Must equal Laravel's existing services.centrifugo.api_url/api_key
# (deploy/centrifugo/.env.centrifugo.example) - same Centrifugo instance.
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=
