# For docker-compose.egress.yml (docker compose auto-loads a .env file next
# to the compose file it runs). Copy to .env in this directory, chmod 600.
#
# Same key/secret pair as livekit.yaml's `keys` block - LiveKit auth is one
# pair shared across room-service calls, participant tokens, AND Egress.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Laravel's server/.env needs the SAME pair plus the host - see the
# "StreamHub / LiveKit" block in server/.env.example for the full set
# (LIVEKIT_HOST, LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_RECORDING_*).
# Not repeated here beyond this pointer - server/.env.example is authoritative.
