[Unit]
Description=Reelsoo VPS-2 auto-failover watchdog (promotes replica if VPS-1 is down)
After=network-online.target reelsoo-db-tunnel.service mysql.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/bin/bash /var/www/reelsoo/deploy/scripts/vps1-watchdog.sh
# Restart only on crash - a clean exit(0) is a deliberate post-failover stop and
# must NOT be restarted (the persistent flag would just make it exit again).
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
