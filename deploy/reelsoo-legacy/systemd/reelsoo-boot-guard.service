[Unit]
Description=Reelsoo VPS-1 split-brain boot guard (demote if VPS-2 is the live primary)
After=mysql.service network-online.target
Requires=mysql.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /var/www/reelsoo/deploy/scripts/vps1-boot-guard.sh
RemainAfterExit=yes
User=root

[Install]
WantedBy=multi-user.target
