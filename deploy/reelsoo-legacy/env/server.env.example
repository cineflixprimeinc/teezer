APP_NAME=Reelsoo
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.reelsoo.com

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reelsoo
DB_USERNAME=reelsoo_user
DB_PASSWORD=CHANGE_ME

# BROADCAST_DRIVER and CACHE_DRIVER are Laravel 10 spellings that Laravel 12
# ignores entirely - the live keys are BROADCAST_CONNECTION and CACHE_STORE.
# Left here only so nobody re-adds them thinking they do something.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Redis connection.
#
# READ THIS BEFORE COPYING TO THE WORKER BOX.
#
# There is exactly one Redis, and it lives on VPS1. The worker box reaches it
# through an SSH tunnel (reelsoo-redis-tunnel.service) published on a DIFFERENT
# local port, because the worker box also runs a redis-server of its own on
# 6379. So:
#
#   on VPS1 (web)      REDIS_PORT=6379   <- the real instance, locally
#   on VPS2 (workers)  REDIS_PORT=6390   <- the tunnel to VPS1's instance
#
# Pointing the worker box at 6379 silently aims it at its own private Redis.
# Nothing errors: the cache just stops being shared, and - once the queue moved
# to Redis - jobs dispatched by the API accumulate on VPS1 while the workers
# poll an empty queue of their own and process nothing. That failure is
# invisible from either box alone; it only shows up by writing a key on one and
# failing to read it on the other.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# The realtime pub/sub bus already used the tunnel, which is why this pair
# exists separately and why the tunnel port was already provisioned.
REALTIME_REDIS_HOST=127.0.0.1
REALTIME_REDIS_PORT=6390

# Must exceed the longest worker --timeout, or Redis re-dispatches a job that
# is still running. The transcoding worker runs with --timeout=3600, so 90 (the
# framework default) would encode the same video over and over.
REDIS_QUEUE_RETRY_AFTER=4000
SESSION_LIFETIME=120
SESSION_DOMAIN=.reelsoo.com
SESSION_SECURE_COOKIE=true

SANCTUM_STATEFUL_DOMAINS=reelsoo.com,www.reelsoo.com,api.reelsoo.com

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@reelsoo.com
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="Reelsoo Admin"
ADMIN_EMAIL=admin@reelsoo.com
ADMIN_PASSWORD=CHANGE_THIS_BEFORE_SEEDING

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=
CLOUDFLARE_R2_REGION=auto
