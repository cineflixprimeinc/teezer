# Copy to `.env` in this directory (NOT committed - already in .gitignore).
# `docker compose up` reads this automatically; apply-routes.sh and
# render-config.sh also source it.

# Admin API key - authenticates route/upstream changes (apply-routes.sh) and
# the Dashboard's connection to the Admin API. Generate with:
#   openssl rand -hex 32
APISIX_ADMIN_KEY=

# Dashboard login + its own session-signing secret. Generate the same way.
APISIX_DASHBOARD_ADMIN_USER=admin
APISIX_DASHBOARD_ADMIN_PASSWORD=
APISIX_DASHBOARD_JWT_SECRET=

# CORS allow-list. MUST mirror server/.env's CORS_ORIGIN exactly - this is
# the single source of truth CORS ownership moved to (see routes/*.json,
# the cors plugin's allow_origins). Wildcarding *.teezer.live is handled
# separately via allow_origins_by_regex in the route configs, not here.
APISIX_CORS_ORIGINS=https://teezer.live,https://www.teezer.live

# Where APISIX sends every request after routing/plugin decisions. This is
# the loopback-only internal nginx vhost (fastcgi_pass to php-fpm) added in
# deploy/nginx/teezer-api-internal.conf - NOT the public teezer-api vhost.
# 127.0.0.1, not host.docker.internal: the whole stack runs with
# network_mode: host (see docker-compose.yml's top comment for why), so
# APISIX shares the host's loopback directly.
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=8091

# The Go service (backend-go), used today only by the knowledge route. It binds
# loopback by default (HOST=127.0.0.1 in its own .env), which is why it needs a
# gateway route to be reachable at all - nothing else proxies to it.
GO_UPSTREAM_HOST=127.0.0.1
GO_UPSTREAM_PORT=8090
