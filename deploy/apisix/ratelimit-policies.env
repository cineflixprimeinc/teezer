# Teezer edge rate-limit policy - the single source of truth for every limit
# APISIX enforces.
#
# Committed on purpose: these are policy, not secrets. The Redis password (if
# one is ever set) belongs in .env alongside APISIX_ADMIN_KEY, not here.
#
# apply-routes.sh sources this file and envsubst substitutes the values into
# routes/*.json, so changing a limit means editing ONE line here and re-running
# ./apply-routes.sh - never editing seven route files.
#
# ---------------------------------------------------------------------------
# WHERE THIS SITS
# ---------------------------------------------------------------------------
# Cloudflare WAF  ->  nginx  ->  APISIX (this file)  ->  Laravel / Go
#
# This is the OUTER, per-IP volume limit. It is deliberately looser than the
# application's own limits, because the application knows things the gateway
# cannot:
#
#   Laravel  throttle:N,M per route, plus RateLimiter::for('login'/'signup-otp'
#            /'social-login'). Keyed on the AUTHENTICATED USER when there is
#            one, IP otherwise, and backed by the Redis cache store - so
#            per-user limits are already distributed. Untouched by this file.
#   Laravel  SecurityRateLimiter - brute-force detection per account, per
#            device fingerprint and per IP, in the `rate_limits` Postgres table
#            with escalating blocks. A different security layer, not a
#            duplicate counter: it reacts to failed AUTHENTICATION, while this
#            reacts to request VOLUME. Untouched by this file.
#   Go       internal/ratelimit.Limiter - Redis INCR+EXPIRE, already
#            distributed. Untouched by this file.
#
# The gateway limit is intentionally the loosest of the three. If a limit here
# starts rejecting real users, that is a bug in this file, not a working
# defence - the application limits are the ones meant to bite first, because
# they can return a precise message and an accurate Retry-After.
#
# ---------------------------------------------------------------------------
# DISTRIBUTED STATE
# ---------------------------------------------------------------------------
# Counters live in Redis (policy: redis), not in each gateway's memory, so the
# limit is global no matter how many APISIX nodes run. There is one node today;
# the moment a second is added, a local counter would silently double every
# limit and let an attacker halve their effective cost by spreading requests.
#
# Algorithm: APISIX limit-count is a FIXED WINDOW. The first request for a key
# sets the counter with a TTL of time_window; the counter is INCR'd atomically
# by Redis for every subsequent request in that window and the key expires on
# its own. Atomicity and the race between "read" and "increment" are Redis's
# problem, not ours - INCR is a single round trip and cannot lose an update
# under concurrency. The trade-off of a fixed window is burst-at-the-boundary:
# a client can spend its whole quota at the end of one window and again at the
# start of the next. limit-req below is what absorbs that.
#
# Isolation: a DEDICATED Redis logical database (see RATELIMIT_REDIS_DATABASE),
# not a key prefix. db0 holds the queue and CounterBuffer, db1 the Laravel
# cache; rate-limit counters get their own so they can never collide with, or
# be flushed alongside, application data. APISIX writes its own
# `limit-count`-prefixed keys inside that database.
#
# ---------------------------------------------------------------------------
# FAILURE BEHAVIOUR
# ---------------------------------------------------------------------------
# allow_degradation=true  -> FAIL OPEN. Redis unreachable means the request is
#                            allowed. Correct for ordinary reads: a Redis blip
#                            must not take the product offline.
# allow_degradation=false -> FAIL CLOSED. Redis unreachable means 429. Correct
#                            only where an unlimited endpoint is worse than an
#                            unavailable one - credential endpoints.
#
# RATELIMIT_REDIS_TIMEOUT bounds how long a request may wait on Redis before
# that degradation path is taken, so a hung Redis cannot hold gateway workers.
# ---------------------------------------------------------------------------

# ── Redis (the existing instance - do not point this at a new one) ──────────
RATELIMIT_REDIS_HOST=127.0.0.1
RATELIMIT_REDIS_PORT=6379
# Dedicated logical DB. 0 = queue/counters, 1 = Laravel cache, 2 = rate limits.
RATELIMIT_REDIS_DATABASE=2
# Milliseconds. Deliberately short: the limiter must never be the slow part of
# a request, and a timeout falls through to the route's degradation setting.
RATELIMIT_REDIS_TIMEOUT=1000

# ── Per-route quotas (requests per window, per client IP) ───────────────────
# Windows are seconds. Values below are the ones already in production; this
# change moves WHERE they are counted, not WHAT they are, so the switch to
# distributed counting cannot itself start rejecting anyone.

# Auth: login, register, password reset, OTP, 2FA. The endpoints
# credential-stuffing tools target, and the only tier that fails closed.
RL_AUTH_COUNT=30
RL_AUTH_WINDOW=60
# Leaky bucket in FRONT of the quota, smoothing bursts. Note: APISIX limit-req
# has no Redis policy - it is per-node by design, because a leaky bucket is
# about instantaneous shape, not a shared budget. rate=10/burst=30 matches what
# production was corrected to after rate=3/burst=10 produced false 429s for
# real users on a single login attempt.
RL_AUTH_REQ_RATE=10
RL_AUTH_REQ_BURST=30

# QR sign-in approval - polled by the waiting device, so it is high-frequency
# by design rather than by abuse.
RL_AUTH_QR_COUNT=600
RL_AUTH_QR_WINDOW=60

# QR sign-in STATUS polling - a separate, wider tier from the auth route above.
# Polled every 3s by design and keyed on an opaque 2-minute ticket, so it was
# carved out of the strict 30/60s cap after real users hit "This code has
# expired" within seconds of opening the QR modal. Unlike its parent auth
# route this fails OPEN: it is a read-only status poll, not a credential
# submission, so failing closed during a Redis blip would break every
# in-progress login for no security gain. Laravel's per-ticket
# qr-login-status limiter (40/min) is the real abuse guard underneath.
RL_AUTH_QR_STATUS_COUNT=150
RL_AUTH_QR_STATUS_WINDOW=60

# Admin API. Fails OPEN: locking every admin out during a Redis blip is worse
# than briefly unlimited admin traffic, which is authenticated anyway.
RL_ADMIN_COUNT=100
RL_ADMIN_WINDOW=60

# Public reads - explore, watch, search, feed. Anonymous traffic.
RL_PUBLIC_COUNT=200
RL_PUBLIC_WINDOW=60

# Signed-in app traffic - videos, comments, notifications, messages, users,
# studio, spaces, calls. One page of the feed fans out to several of these, so
# the ceiling is high; Laravel's per-user throttles are the real limit here.
RL_AUTHENTICATED_COUNT=600
RL_AUTHENTICATED_WINDOW=60

# Ads/campaign management.
RL_ADS_COUNT=600
RL_ADS_WINDOW=60

# Everything else under /api/v1.
RL_CATCHALL_COUNT=300
RL_CATCHALL_WINDOW=60

# Wikipedia knowledge cards, served by the Go backend. Deliberately above the
# Go handler's own 30/min per IP so the application limit is the one that
# normally applies and returns a useful JSON body; this only sheds a flood
# before it reaches the process.
RL_KNOWLEDGE_COUNT=60
RL_KNOWLEDGE_WINDOW=60
