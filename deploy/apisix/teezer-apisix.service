# systemd unit - wraps the APISIX gateway stack's docker compose lifecycle,
# matching this repo's boot-persistence pattern (teezer-livekit-tunnel.service,
# centrifugo.service) for services not natively systemd-managed.
#
# Install:
#   cp teezer-apisix.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now teezer-apisix
#
[Unit]
Description=Teezer APISIX API gateway stack (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/var/www/teezer/deploy/apisix
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
