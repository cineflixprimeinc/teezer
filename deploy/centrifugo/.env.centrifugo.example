# Centrifugo secrets/config - Teezer.
# Copy to `.env` (docker-compose) or `/etc/centrifugo/centrifugo.env` (systemd).
# Generate each secret with:  openssl rand -hex 32

# HMAC secret used to sign client connection + subscription JWTs.
# MUST equal Laravel's CENTRIFUGO_TOKEN_SECRET.
CENTRIFUGO_TOKEN_SECRET=

# Server publish API key. MUST equal Laravel's CENTRIFUGO_API_KEY.
CENTRIFUGO_API_KEY=

# Web admin UI (http://<host>:8000/). Keep port 8000 firewalled to localhost + app boxes.
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=

# Redis engine - box-local Redis; cross-node fan-out/presence/history over Redis.
# systemd installs also need these two (docker-compose sets them from the block above):
CENTRIFUGO_ENGINE=redis
CENTRIFUGO_REDIS_ADDRESS=redis://127.0.0.1:6379
