# Dependencies / build output (all apps)
# ========================
node_modules/
vendor/
.next/
out/
dist/
build/
.expo/
*.tsbuildinfo

# local deploy secrets / keys (never commit)
.deploy.local.*
*deploy*key*
id_ed25519*

# Local Socket.IO chat-server working dir - dependencies only, no tracked source
chat-server/
