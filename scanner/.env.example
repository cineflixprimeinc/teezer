SCANNER_HOST=127.0.0.1
SCANNER_PORT=7891

# Shared secret Laravel sends back as X-Scanner-Key on every /scan/* call
# (server/.env's SCANNER_API_KEY must match). Leave blank only if the
# scanner port is unreachable from anywhere but the Laravel host itself.
SCANNER_API_KEY=

# Comma-separated hostnames download_url is allowed to point at, in addition
# to the always-on block on private/loopback/link-local addresses in
# scanner/security.py. Leave blank to rely on the private-address block alone.
ALLOWED_DOWNLOAD_HOSTS=

# Decision thresholds (overrides DB settings for local scanner defaults)
NUDITY_REJECT_THRESHOLD=0.85
NUDITY_PENDING_THRESHOLD=0.65
NSFW_REJECT_THRESHOLD=0.85
NSFW_PENDING_THRESHOLD=0.65

# Video frame extraction
VIDEO_FRAME_INTERVAL=2
VIDEO_SCAN_DURATION=120
VIDEO_FULL_SCAN_FRAME_INTERVAL=1

# Allowed internal origins
ALLOWED_ORIGINS=http://127.0.0.1,http://localhost

# Logging
LOG_LEVEL=INFO
