PORT=8081

DB_PGSQL_HOST=127.0.0.1
DB_PGSQL_PORT=5433
DB_PGSQL_DATABASE=teezer
DB_PGSQL_USERNAME=teezer
# REQUIRED - a SECRET, left blank on purpose. This file is committed, so a real
# value here would be a published credential; it also used to ship a working
# default, which is exactly the "default credentials" mistake. The service
# refuses to start when this is unset (config.Validate), rather than assembling
# a DSN with an empty password and failing later in a way that looks unrelated.
DB_PGSQL_PASSWORD=
# Loopback or SSH-tunnelled connections only, which is why plaintext is the
# default here. Set this to `require` (or stricter) the moment Postgres is
# reached over any network that is not the local host or an encrypted tunnel.
DB_PGSQL_SSLMODE=disable

# Optional. When unset, rate limiting/dedupe/cache-busting run in an
# in-process, single-instance fallback - fine for local dev, not for
# multiple instances behind a load balancer.
REDIS_URL=

HOST=127.0.0.1

# Full Postgres DSN. When set it OVERRIDES every DB_PGSQL_* key above; when
# empty the DSN is assembled from them. Contains the password, so treat the
# whole string as a SECRET.
# ⚠️ This service keeps its own .env, separate from Laravel's. After any
# database move, update it here TOO or the service crash-loops on "SASL auth
# failed" while Laravel keeps working.
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Shared with Laravel - these values must be byte-identical to server/.env or
# the two services disagree about signatures and encryption.
# APP_KEY            - same key Laravel uses; decrypts the same columns.
# MEDIA_SIGNING_SECRET - shared HMAC with the media Worker; a mismatch 403s
#                        every video.
# All three below are SECRETS.
# ─────────────────────────────────────────────────────────────────────────────
APP_KEY=
MEDIA_SIGNING_SECRET=
TURNSTILE_SECRET_KEY=

# Public CDN host that fronts the bucket - never the bucket endpoint.
MEDIA_URL=https://cdn.teezer.live

# ─────────────────────────────────────────────────────────────────────────────
# Backblaze B2 - object storage. Key and key ID are SECRETS.
# B2_REGION is optional: it is derived from the endpoint host when omitted.
# Setting both invites the failure where they disagree and every request fails
# SigV4 naming neither.
# ─────────────────────────────────────────────────────────────────────────────
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=
# B2_REGION=

# ─────────────────────────────────────────────────────────────────────────────
# Centrifugo - realtime. API URL is the internal address, never the public
# wss:// URL. The API key is a SECRET and must match Centrifugo's own config.
# ─────────────────────────────────────────────────────────────────────────────
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=

# ClickHouse analytics DSN - carries credentials, so it is a SECRET.
CLICKHOUSE_DSN=

# NATS message bus. Optional.
NATS_URL=

# Text moderation - non-secret tuning, shown with the code's defaults.
TEXT_MODERATION_ENABLED=true
TEXT_MODERATION_REVIEW_THRESHOLD=2
